{
  "name": "pi-plan-mode-autoswitch",
  "version": "0.1.0",
  "description": "Pi Plan Mode with optional automatic model switching at Plan boundaries (entry / exit).",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "周凯 <851708184@qq.com>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "plan-mode",
    "planning",
    "autoswitch",
    "model-switch"
  ],
  "files": [
    "src",
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./dist/index.ts"
    ]
  },
  "scripts": {
    "build": "node scripts/build-runtime.mjs",
    "check": "npm run build && biome check . && npm run typecheck",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EightDoor/pi-plan-mode-autoswitch"
  },
  "homepage": "https://github.com/EightDoor/pi-plan-mode-autoswitch#readme",
  "bugs": {
    "url": "https://github.com/EightDoor/pi-plan-mode-autoswitch/issues"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "^0.65.2"
  }
}
